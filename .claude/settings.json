{
  "permissions": {
    "allow": [
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql"
    ],
    "deny": [
      "Read(~/.config/werkflow/boat-api-key)",
      "Read(~/.config/ascii/boat/**)",
      "Edit(~/.config/werkflow/boat-api-key)",
      "Edit(~/.config/ascii/boat/**)",
      "Read(~/.config/werkflow/problem-report-handout.env)",
      "Edit(~/.config/werkflow/problem-report-handout.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/guard-edits-during-verification.ts\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-unresolvable-delete.ts\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-production-logs.ts\"; code=$?; [ \"$code\" -eq 0 ] || [ \"$code\" -eq 2 ] || echo \"Refused: the log guard failed with exit $code, so it cannot rule out PROD logs.\" >&2; [ \"$code\" -eq 0 ] && exit 0; exit 2",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-heavy-commands.ts\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-second-stack.ts\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-production-mcp.ts\"; code=$?; [ \"$code\" -eq 0 ] || [ \"$code\" -eq 2 ] || echo \"Refused: the MCP guard failed with exit $code, so it cannot rule out PROD.\" >&2; [ \"$code\" -eq 0 ] && exit 0; exit 2",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-boat-key-reads.ts\"; code=$?; [ \"$code\" -eq 0 ] || [ \"$code\" -eq 2 ] || echo \"Refused: the Boat key guard failed with exit $code, so it cannot rule out a read of the key.\" >&2; [ \"$code\" -eq 0 ] && exit 0; exit 2",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__t3-code__device_open",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-device-without-room.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
