{
  "machine": "mac",
  "repository": "werk-flow/werkflow-app",
  "trustedCheckout": "/Users/ci/ci-runner/werkflow-app",
  "stateDir": "/Users/ci/ci-runner/state",
  "windowsFile": "/Users/ci/ci-runner/windows.json",
  "appKeyFile": "/Users/ci/ci-runner/key/ci-app.pem",
  "slot": {
    "prefix": ["colima", "ssh", "--profile", "ci", "--"],
    "dockerHost": null,
    "socket": "/var/run/docker.sock",
    "root": "/var/lib/werkflow-ci",
    "image": "werkflow-ci:COMMIT",
    "containerUser": "image"
  },
  "probePorts": [
    "host.lima.internal:54321",
    "host.lima.internal:54322",
    "host.lima.internal:54323",
    "host.lima.internal:54324",
    "host.lima.internal:54325",
    "host.lima.internal:54326",
    "host.lima.internal:54327",
    "host.lima.internal:3000",
    "host.lima.internal:3773"
  ],
  "reset": [
    "/Users/ci/ci-runner/werkflow-app/ci/slot/reset-colima.sh",
    "/Users/ci/ci-runner/image/werkflow-ci.tar"
  ],
  "sizes": {
    "4/6": {
      "resize": ["sh", "-c", "colima stop --profile ci && colima start --profile ci --cpu 4 --memory 6"]
    },
    "8/8": {
      "resize": ["sh", "-c", "colima stop --profile ci && colima start --profile ci --cpu 8 --memory 8"]
    }
  },
  "seedSeconds": { "full": 10800, "selected": 2400 },
  "leaseTtlSeconds": 600
}
