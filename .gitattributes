# Every text file is LF in the index and on checkout, whatever core.autocrlf
# says: Prettier (bun run format:check) and the line-based tooling expect LF.
* text=auto eol=lf
# Markdown is LF in the index and on checkout; tooling splits on \n
*.md text eol=lf
# Git runs the hooks with sh, which cannot read CRLF
.githooks/* text eol=lf
