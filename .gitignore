# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Historical Golden test artifact paths
tests/golden/.artifacts/
tests/golden/.results/
tests/golden/.report/

# Historical audit result paths
tests/audit/.results/
tests/audit/.report/

# Historical cloud-canary result paths
tests/canary/.results/
tests/canary/.report/

# Agent logs and run-owned verification archives
.agent-logs/
.coderabbit-*.jsonl
